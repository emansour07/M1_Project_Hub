# Configure these in the company service environment. Django does not load this file automatically.
DJANGO_SECRET_KEY=replace-with-a-long-random-server-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=m1.company-domain.example
M1_PUBLIC_URL=https://m1.company-domain.example
M1_DB_PATH=/private/company/path/m1.sqlite3
M1_MEDIA_ROOT=/private/company/path/media

# Existing M1-only Autodesk integration; never use the SB05 application's credentials.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_SSA_ID=
APS_SSA_KID=
APS_SSA_PRIVATE_KEY_PATH=/private/company/path/m1-service-account.pem
M1_LOGIN_CLIENT_ID=
M1_LOGIN_CLIENT_SECRET=

# Register https://<company-M1-host>/api/forma/callback on the M1 editor-login APS app.
# The service account must retain M1-only membership and the required folder access.

M1_NOTIFICATION_EMAIL=eslam.mansour@arx.ing
M1_SENDER_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Enable only after IT has configured and verified each corresponding connection.
M1_MAIL_ENABLED=false
M1_PROVISION_ENABLED=false
M1_UPLOAD_ENABLED=false
M1_TRACKER_WRITE_ENABLED=false
