<?xml version='1.0' encoding='utf-8'?>
<MCSettings AllowRequired="False" Name="M1 Model Health — Local Pilot v1" Author="ARX — adapted from Autodesk Model Checker published checks" Description="Local model health observations and confirmed model hygiene checks. Asset information and COBie requirements remain pending client clarification. No cloud checking." LastModified="133656248775774024">
  <Heading ID="8024afd4-617e-4ad1-b640-21c0134065a1" HeadingText="M1 Model Health" Description="Confirm in the installed Model Checker before production use." IsChecked="True">
    <Section ID="fa5a450c-80f7-4f92-b609-6b7df2a99d43" SectionName="Health observations" Title="Health observations" Description="" IsChecked="True">
      <Check ID="88fc3c24-debd-4d69-a8ed-e26e7a3d191c" CheckName="File Size" Description="RESULT of the file sizes for all reported Revit models in MB (megabytes)." FailureMessage="" ResultCondition="FailMatchingElements" CheckType="FileSize" IsRequired="False" IsChecked="True" />
      <Check ID="9fd68140-9955-4c58-bd0e-757234f5beb0" CheckName="Warnings" Description="COUNT of all warnings in the model. Too many unresolved warnings can cause performance issues in a Revit model." FailureMessage="" ResultCondition="CountOnly" CheckType="WarningCount" IsRequired="False" IsChecked="True">
        <PrebuiltOptions ShowList="True" />
      </Check>
      <Check ID="00066391-315f-41d4-accc-b7349e26ed90" CheckName="Loadable Families" Description="RESULT and LIST of the families in the project ordered by file size. **WARNING** Running this check can take a significant amount of time, depending on how many loadable families the model has." FailureMessage="" ResultCondition="FailMatchingElements" CheckType="TenLargestFamilies" IsRequired="False" IsChecked="True" />
      <Check ID="cbcd1190-c9fa-4d4f-a1c8-f812a460f86d" CheckName="Model Groups" Description="COUNT of all model group elements in the model. Too many model groups can be an indication of improper modeling techniques." FailureMessage="" ResultCondition="CountAndList" CheckType="Custom" IsRequired="False" IsChecked="True">
        <Filter ID="c7e50838-2e64-4ced-847f-7674443c2926" Operator="And" Category="Category" Property="OST_IOSModelGroups" Condition="Included" Value="True" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="47b12d44-9873-47ea-8082-1add5ce42dbf" Operator="And" Category="TypeOrInstance" Property="Is Element Type" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
      </Check>
      <Check ID="7cfbe1ef-250d-4a6c-a599-1ef5aec441da" CheckName="Detail Groups" Description="COUNT of all detail group elements in the model. Too many detail groups can be an indication of improper modeling techniques." FailureMessage="" ResultCondition="CountAndList" CheckType="Custom" IsRequired="False" IsChecked="True">
        <Filter ID="6a2f1bd9-582e-4c43-9338-57eb9ae8d988" Operator="And" Category="Category" Property="OST_IOSDetailGroups" Condition="Included" Value="True" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="eb01df4e-7a67-4389-999a-00c4b7a2159d" Operator="And" Category="TypeOrInstance" Property="Is Element Type" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
      </Check>
      <Check ID="54f5a90e-e583-41be-b534-de13a8133593" CheckName="In-Place Families" Description="COUNT of all in-place family elements in the model. In-place families can signifcantly impact model size and performance and should be used sparingly." FailureMessage="" ResultCondition="CountAndList" CheckType="Custom" IsRequired="False" IsChecked="True">
        <Filter ID="d4eef4c2-91ad-4d5e-9edb-5d6d544c2ee9" Operator="And" Category="APIType" Property="Full Class Name" Condition="Equal" Value="Autodesk.Revit.DB.Family" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="dbfffe37-2985-44ad-87e8-1a3b6d107c08" Operator="And" Category="APIParameter" Property="IsInPlace" Condition="Equal" Value="True" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
      </Check>
      <Check ID="b2ac375e-c4e1-482e-8dcf-dfa8e9be0fe8" CheckName="Revit Version" Description="LIST of the version and build data of Revit running the check." FailureMessage="" ResultCondition="FailMatchingElements" CheckType="RevitVersion" IsRequired="False" IsChecked="True" />
      <Check ID="f2fd800b-15e1-4959-a136-eb93cad418c8" CheckName="Design Options" Description="COUNT and LIST of all elements created in each design option of the model." FailureMessage="" ResultCondition="CountOnly" CheckType="DesignOptions" IsRequired="False" IsChecked="True">
        <PrebuiltOptions ShowCount="True" />
      </Check>
      <Check ID="3d92dc67-2a58-4005-8be6-2d0daea1a50b" CheckName="Elements Per Phase" Description="COUNT and LIST of all elements in each phase of the model." FailureMessage="" ResultCondition="FailMatchingElements" CheckType="PhaseElements" IsRequired="False" IsChecked="True" />
      <Check ID="4a1642fb-d115-4e92-ba8c-c8d73f6b4542" CheckName="Worksets" Description="COUNT and LIST of all user worksets in the model or indicates '*Not Workshared*' if worksharing is not enabled." FailureMessage="" ResultCondition="CountOnly" CheckType="Worksets" IsRequired="False" IsChecked="True">
        <PrebuiltOptions ShowCount="False" />
      </Check>
      <Check ID="4ac4cdbb-4158-4627-82be-935f8c817d1e" CheckName="Project Information" Description="COUNT and LIST of all parameters and values attached to Project Information for a project except those associated with Revit Extensions (starting with 'Extensions')." FailureMessage="" ResultCondition="CountAndList" CheckType="ProjectInformation" IsRequired="False" IsChecked="True" />
      <Check ID="b29f6eb5-5529-4d8e-a196-b304316ea828" CheckName="Project Coordinates" Description="COUNT and LIST of the coordinate values of the survey and project base points, elevation, and true north." FailureMessage="" ResultCondition="FailMatchingElements" CheckType="ProjectCoordinates" IsRequired="False" IsChecked="True" />
      <Check ID="47f482e7-9220-4f8d-ae91-e80121aeb51b" CheckName="Linked Revit Files and Their Link Method" Description="COUNT and LIST of the link method (overlay vs. attach) for each Revit link in the model." FailureMessage="" ResultCondition="FailMatchingElements" CheckType="LinkMethod" IsRequired="False" IsChecked="True" />
      <Check ID="1a4c22e9-4d53-4bda-8ef0-e53243c6307d" CheckName="Linked Revit Files Not Pinned in Place" Description="PASS/FAIL check to determine if any linked Revit files are not pinned in place. Will Fail if any are found." FailureMessage="There are linked Revit models that are not pinned in place." ResultCondition="CountAndList" CheckType="Custom" IsRequired="False" IsChecked="True">
        <Filter ID="9c38d5e6-50be-4a05-80a8-d41b0fa22ecc" Operator="And" Category="Category" Property="OST_RvtLinks" Condition="Included" Value="True" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="3881ee61-a9b1-4e88-8198-e39d5c709c5a" Operator="And" Category="APIParameter" Property="Pinned" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="ab6aac79-1279-44ac-b37e-95d13c028bbc" Operator="And" Category="TypeOrInstance" Property="Is Element Type" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
      </Check>
      <Check ID="efa5aece-b386-48a0-abdb-e97c81e51a99" CheckName="Linked CAD Files" Description="COUNT and LIST of all linked CAD files in the model." FailureMessage="" ResultCondition="CountAndList" CheckType="Custom" IsRequired="False" IsChecked="True">
        <Filter ID="e1af7eea-654d-4a86-9ebb-359eeee5b8ca" Operator="And" Category="APIType" Property="Full Class Name" Condition="Equal" Value="Autodesk.Revit.DB.ImportInstance" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="90d5d876-fb88-4a88-be2b-1087fb4403fa" Operator="And" Category="APIParameter" Property="IsLinked" Condition="Equal" Value="True" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="8af76d5c-8f5e-4c18-89cf-fd77ddb1bd3b" Operator="And" Category="TypeOrInstance" Property="Is Element Type" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
      </Check>
      <Check ID="7d905309-a094-48f2-96a2-314a0ea20b3a" CheckName="Levels" Description="COUNT of all level elements in the model." FailureMessage="[FAIL MESSAGE]" ResultCondition="CountAndList" CheckType="Custom" IsRequired="False" IsChecked="True">
        <Filter ID="0faf4fb2-3336-4314-ae38-5c4b59127939" Operator="And" Category="Category" Property="OST_Levels" Condition="Included" Value="True" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="3135a628-febd-454c-8441-98a4beab68a1" Operator="And" Category="TypeOrInstance" Property="Is Element Type" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
      </Check>
      <Check ID="75f90966-60c6-4e7b-998d-d5778e2d8f23" CheckName="Grids" Description="COUNT of all grid elements in the model." FailureMessage="[FAIL MESSAGE]" ResultCondition="CountAndList" CheckType="Custom" IsRequired="False" IsChecked="True">
        <Filter ID="953d07ba-b965-4f67-a8e7-1c264aabe58c" Operator="And" Category="Category" Property="OST_Grids" Condition="Included" Value="True" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="b26a1cd3-8c5c-4165-9dfc-10af5c56a90b" Operator="And" Category="TypeOrInstance" Property="Is Element Type" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
      </Check>
    </Section>
    <Section ID="1599a213-e388-4dc7-bf84-072b90eca1e4" SectionName="Model hygiene findings" Title="Model hygiene findings" Description="" IsChecked="True">
      <Check ID="7a678598-c68d-4d1f-8a8e-674ae9b403e7" CheckName="Imported CAD files" Description="Find CAD imports in the model. Confirm applicability and correct in the native model; this checker does not modify files." FailureMessage="Imported CAD found. Review against the M1 model compliance requirement." ResultCondition="FailMatchingElements" CheckType="Custom" IsRequired="False" IsChecked="True">
        <Filter ID="5fab9f92-8ba6-4c73-b253-2322fd1d3c57" Operator="And" Category="APIType" Property="Full Class Name" Condition="Equal" Value="Autodesk.Revit.DB.ImportInstance" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="b7371a8a-adff-47b7-8621-bbd29801c6fe" Operator="And" Category="APIParameter" Property="IsLinked" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="bef31a1a-f15d-4406-b593-8a490fc05078" Operator="And" Category="TypeOrInstance" Property="Is Element Type" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
      </Check>
      <Check ID="116d6030-5fca-4fa4-a59d-8fd8dc983e1f" CheckName="Duplicate Modeled Elements" Description="PASS/FAIL check to determine if there are any modeled elements that are duplicates (identical elements at the same location and base level). Check will Fail if any duplicate element is found. **WARNING** Running this check can take a significant amount of time to complete." FailureMessage="Element is a duplicate at the same location and base level." ResultCondition="FailMatchingElements" CheckType="Custom" IsRequired="False" IsChecked="True">
        <Filter ID="60aaaf73-a5e9-4d22-a1a7-6001258f0ef2" Operator="And" Category="APIType" Property="Full Class Name" Condition="Equal" Value="Autodesk.Revit.DB.FamilyInstance" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="7a5ec9b5-bd91-42d7-8ced-cc98c85631af" Operator="And" Category="View" Property="Is Defined" Condition="Equal" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="084be1de-138e-4502-9ab6-fb4294ef1ff9" Operator="And" Category="Redundant" Property="Location" Condition="Equal" Value="True" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="dfc5b319-64fb-4eba-a907-46e97a1c710f" Operator="And" Category="Parameter" Property="DESIGN_OPTION_ID" Condition="HasValue" Value="False" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
        <Filter ID="9a0924bc-5e6b-414e-95ba-0456482a0cb6" Operator="Exclude" Category="Category" Property="OST_Truss" Condition="Included" Value="True" CaseInsensitive="False" Unit="None" UnitClass="None" FieldTitle="" UserDefined="False" Validation="None" />
      </Check>
    </Section>
  </Heading>
</MCSettings>