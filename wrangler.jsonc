{
  "name": "m1-project-api",
  "main": "cloudflare/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "M1_UPLOADER_EMAIL": "eslam.mansour@ymail.com",
    "ACC_PROJECT_ID": "e80ed581-2f73-4b70-a8d1-f100b9b95f4d",
    "ACC_DESIGN_FOLDER_ID": "urn:adsk.wipemea:fs.folder:co.6tClIOPzQGyEeWnblrUTng",
    "FRONTEND_ORIGIN": "https://emansour07.github.io",
    "FRONTEND_URL": "https://emansour07.github.io/M1_Project_Hub/",
    "FORMA_SYNC_ENABLED": "false",
    "FORMA_BATCHED": "true"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_STATE",
        "class_name": "M1State"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "M1State"
      ]
    }
  ],
  "account_id": "8bb04fb9d237ef2eec26acbb6ddca6ab"
}